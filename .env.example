# .env.example — copy to .env.local
# See plan.md Section 14 for full documentation

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=testnet

# Database (Supabase or local Docker)
DATABASE_URL=postgresql://titip:titip@localhost:5432/titip_db

# Stellar network
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_CONTRACT_ADDRESS=            # Set after: stellar contract deploy
NEXT_PUBLIC_USDC_ASSET_CODE=USDC
NEXT_PUBLIC_USDC_ISSUER=GDPQBFYZYWZZHUANOLL2TOIJVIP4JLVRHXTYGGVDGASOW6RGM26MSXZ2

# Demo contingency — set to "true" to use mock contract (no Soroban RPC needed)
NEXT_PUBLIC_USE_MOCK_CONTRACT=false

# Auth
JWT_SECRET=change_me_to_a_long_random_string
SEP10_WEB_AUTH_DOMAIN=localhost:3000

# Oracle (server-side only — NEVER expose to client)
ORACLE_SECRET_KEY=                       # Oracle service ONLY (apps/oracle) — never set on the web app in production
SEP10_SERVER_SECRET_KEY=                 # Web app: dedicated keypair for SEP-10 challenges (NOT the oracle key)
ORACLE_INTERNAL_API_KEY=                 # Shared secret for /api/oracle/confirm
# Oracle service only (apps/oracle). Defaults to testnet when unset; a mainnet node MUST set mainnet
# (it picks the network passphrase and disables the mock courier adapter).
STELLAR_NETWORK=testnet
# Unique per node (A-Z a-z 0-9 _ -, max 64): names the node's BullMQ queue and labels its oracle_events.
ORACLE_NODE_ID=oracle-primary

# Redis
REDIS_URL=redis://localhost:6379

# Courier APIs
JNT_API_KEY=
JNT_API_URL=https://api.jet.co.id
JNE_API_KEY=
JNE_API_URL=https://apiv2.jne.co.id:10101
SICEPAT_API_KEY=
SICEPAT_API_URL=https://api.sicepat.com

# Courier webhook HMAC secrets (one per courier; web app ingestion route, server-side only)
COURIER_WEBHOOK_SECRET_JNT=
COURIER_WEBHOOK_SECRET_JNE=
COURIER_WEBHOOK_SECRET_SICEPAT=
COURIER_WEBHOOK_SECRET_ANTERAJA=
COURIER_WEBHOOK_SECRET_POS_INDONESIA=

# Optional: Supabase (if using hosted PG)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Demo accounts (set after running scripts/fund-testnet-accounts.ts)
DEMO_BUYER_SECRET=
DEMO_SELLER_SECRET=
DEMO_USDC_ISSUER_SECRET=             # Only if you control the mock USDC issuer

# Optional: shared rate limiting across serverless instances (falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
